# ---------------------------------------------------------------------------
# GameVoicesBot environment variables
# Copy this file to ".env" and fill in real values for local development.
# On Render, set these under the service's "Environment" tab instead.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceThis

# Target channel where game news will be posted.
# Use the numeric ID (e.g. -1001234567890) or the public @username.
# The bot must be added to the channel as an administrator with post rights.
CHANNEL_ID=@your_channel_username

# Comma-separated Telegram numeric user IDs allowed to use admin commands.
# You can get your own numeric ID from @userinfobot on Telegram.
ADMIN_IDS=111111111,222222222

# RAWG.io API key (free) - https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# --- Optional translation settings ---
# If TRANSLATE_ENABLED=false, posts use the original (English) description.
TRANSLATE_ENABLED=true
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# --- Scheduler settings ---
POST_INTERVAL_HOURS=6
GAMES_LOOKBACK_DAYS=3
GAMES_PER_RUN=4
TIMEZONE=Asia/Tashkent

# --- Logging ---
LOG_LEVEL=INFO
